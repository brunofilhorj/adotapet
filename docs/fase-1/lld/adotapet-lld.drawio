  <diagram id="lld-page-6" name="6. Fluxos Detalhados">
    <mxGraphModel dx="1434" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p6-title" value="AdotaPet - LLD: Fluxos Detalhados do MVP" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="760" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p6-search-title" value="Fluxo 1: Busca de filhotes proximos" style="text;html=1;strokeColor=none;fillColor=#dae8fc;align=left;verticalAlign=middle;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="440" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p6-s1" value="1. App obtem GPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1"><mxGeometry x="60" y="130" width="170" height="50" as="geometry" /></mxCell>
        <mxCell id="p6-s2" value="2. GET /puppies/search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" vertex="1" parent="1"><mxGeometry x="260" y="130" width="180" height="50" as="geometry" /></mxCell>
        <mxCell id="p6-s3" value="3. SearchUseCase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1"><mxGeometry x="470" y="130" width="170" height="50" as="geometry" /></mxCell>
        <mxCell id="p6-s4" value="4. CachePort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1"><mxGeometry x="670" y="130" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="p6-s5" value="5. PostGIS query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11" vertex="1" parent="1"><mxGeometry x="850" y="130" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="p6-s6" value="6. Lista paginada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1"><mxGeometry x="1040" y="130" width="170" height="50" as="geometry" /></mxCell>
        <mxCell id="p6-listing-title" value="Fluxo 2: Cadastro de filhote" style="text;html=1;strokeColor=none;fillColor=#dae8fc;align=left;verticalAlign=middle;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="440" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p6-l1" value="1. Solicita upload URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1"><mxGeometry x="60" y="290" width="170" height="50" as="geometry" /></mxCell>
        <mxCell id="p6-l2" value="2. Upload S3 direto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11" vertex="1" parent="1"><mxGeometry x="260" y="290" width="170" height="50" as="geometry" /></mxCell>
        <mxCell id="p6-l3" value="3. POST /puppies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" vertex="1" parent="1"><mxGeometry x="460" y="290" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="p6-l4" value="4. Valida role e dominio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1"><mxGeometry x="650" y="290" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="p6-l5" value="5. Geocoding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11" vertex="1" parent="1"><mxGeometry x="870" y="290" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="p6-l6" value="6. Persiste + invalida cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1"><mxGeometry x="1050" y="290" width="210" height="50" as="geometry" /></mxCell>
        <mxCell id="p6-chat-title" value="Fluxo 3: Chat in-app" style="text;html=1;strokeColor=none;fillColor=#dae8fc;align=left;verticalAlign=middle;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="440" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p6-c1" value="1. Contato no perfil" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1"><mxGeometry x="60" y="450" width="170" height="50" as="geometry" /></mxCell>
        <mxCell id="p6-c2" value="2. POST /conversations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" vertex="1" parent="1"><mxGeometry x="260" y="450" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="p6-c3" value="3. Abre WSS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" vertex="1" parent="1"><mxGeometry x="480" y="450" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="p6-c4" value="4. MESSAGE_SEND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1"><mxGeometry x="660" y="450" width="170" height="50" as="geometry" /></mxCell>
        <mxCell id="p6-c5" value="5. Persiste mensagem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1"><mxGeometry x="860" y="450" width="180" height="50" as="geometry" /></mxCell>
        <mxCell id="p6-c6" value="6. Realtime ou push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11" vertex="1" parent="1"><mxGeometry x="1070" y="450" width="170" height="50" as="geometry" /></mxCell>
        <mxCell id="p6-obs" value="NFRs do MVP&#xa;&#xa;- Busca p95 &lt; 500ms&#xa;- HTTPS/WSS obrigatorio&#xa;- Rate limit em login/cadastro/busca&#xa;- Logs com traceId&#xa;- Metricas de latencia, erros, cache hit, mensagens/min&#xa;- LGPD: desativacao/exclusao e logs sem dados sensiveis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="60" y="570" width="560" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p6-jobs" value="Jobs&#xa;&#xa;ExpireListingsJob&#xa;- diario&#xa;- notifica anuncio sem atualizacao ha 90 dias&#xa;- pausa apos 14 dias sem resposta&#xa;&#xa;SavedSearchNotificationJob&#xa;- a cada 15 min ou por evento&#xa;- max 1 notificacao por busca em 24h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="700" y="570" width="430" height="210" as="geometry" />
        </mxCell>
