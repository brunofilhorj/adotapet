  <diagram id="lld-page-5" name="5. Banco e Migrations">
    <mxGraphModel dx="1434" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p5-title" value="AdotaPet - LLD: Banco de Dados, Indices e PostGIS" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="330" y="20" width="860" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p5-ext" value="Extensoes&#xa;&#xa;CREATE EXTENSION postgis;&#xa;CREATE EXTENSION pgcrypto;&#xa;&#xa;Flyway: V1__init_schema.sql" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="70" y="100" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p5-users" value="users&#xa;profiles&#xa;&#xa;users: id, email, password_hash, role, status, timestamps&#xa;&#xa;profiles: user_id, name, phone, city, state, location, avatar_url, bio&#xa;&#xa;Relacao interna: users 1:1 profiles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="410" y="100" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p5-puppies" value="puppies&#xa;puppy_photos&#xa;&#xa;puppies: owner_id, name, breed, species, age_months, size, sex, description, location, city, state, status, adopted_at&#xa;&#xa;photos: puppy_id, url, sort_order, is_primary&#xa;&#xa;Relacao interna: puppies 1:N puppy_photos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="790" y="100" width="360" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p5-chat" value="conversations&#xa;messages&#xa;&#xa;conversations: puppy_id, adopter_id, donor_id, status, timestamps&#xa;&#xa;messages: conversation_id, sender_id, content, sent_at, read_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=8;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="410" y="390" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p5-search" value="favorites&#xa;saved_searches&#xa;&#xa;favorites: user_id + puppy_id PK&#xa;&#xa;saved_searches: user_id, name, filters JSONB, notify_on_match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="790" y="410" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p5-index" value="Indices principais&#xa;&#xa;GIST puppies.location&#xa;(status, created_at DESC)&#xa;owner_id&#xa;(species, size, sex, age_months)&#xa;(conversation_id, sent_at DESC)&#xa;conversations adopter_id / donor_id&#xa;GIN saved_searches.filters&#xa;unique primary photo por puppy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="1190" y="120" width="300" height="270" as="geometry" />
        </mxCell>
        <mxCell id="p5-postgis" value="Query PostGIS&#xa;&#xa;ST_DWithin(location, point, radius)&#xa;ST_Distance(location, point) / 1000 AS distance_km&#xa;&#xa;WHERE status = AVAILABLE&#xa;+ species/size/sex/age filters&#xa;&#xa;ORDER BY distance_km ASC, created_at DESC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="1190" y="460" width="300" height="240" as="geometry" />
