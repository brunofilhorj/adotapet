        <mxCell id="p5-e2" value="N:N favoritos / buscas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="p5-puppies" target="p5-search"><mxGeometry relative="1" as="geometry" /></mxCell>
